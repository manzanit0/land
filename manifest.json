{
    "manifest_version": 3,
    "name": "land",
    "version": "1.1.0",
    "description": "PR triage and bookmarks on every new tab.",
    "browser_specific_settings": {
        "gecko": {
            "id": "land@manzanit0",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": ["authenticationInfo"]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "icons": {
        "48": "icon.svg",
        "96": "icon.svg"
    },
    "chrome_url_overrides": {
        "newtab": "index.html"
    }
}
